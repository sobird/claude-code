# Copy to .env (docker compose reads it automatically) and replace every
# "replace-me" value. Never commit a real .env.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=insecure-dev-postgres-password
# Full DSN used by both the Next server and the gateway. In compose the host is
# the `postgres` service name; for a local `bun run dev` use 127.0.0.1.
DATABASE_URL=postgres://rcs:insecure-dev-postgres-password@postgres:5432/rcs

# ── Gateway signing secret (REQUIRED) ─────────────────────────────────────────
# Signs access/environment/worker JWTs and Auth.js session cookies. Generate one:
#   openssl rand -hex 32
RCS_AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# ── Bootstrap administrator (first boot, empty users table only) ──────────────
# `ensureBootstrapAdmin` creates this user once and then never touches it again.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me-with-a-strong-password

# ── Gateway tunables (optional) ───────────────────────────────────────────────
RCS_PORT=4000
RCS_HOST=0.0.0.0
# Public origin embedded in work secrets / environment tokens. Must be reachable
# by the CLI. Use https://<your-domain> in production.
RCS_BASE_URL=http://localhost
# Legacy shared API keys, comma separated. Prefer per-user keys from the UI.
RCS_API_KEYS=
RCS_POLL_TIMEOUT=8
RCS_HEARTBEAT_INTERVAL=20
RCS_JWT_EXPIRES_IN=3600
RCS_ENV_TOKEN_TTL=2592000
RCS_DISCONNECT_TIMEOUT=300
RCS_WS_IDLE_TIMEOUT=30
RCS_WS_KEEPALIVE_INTERVAL=20
RCS_EVENT_REPLAY_LIMIT=5000
# Only needed for split-host deployments: origins allowed to call /web/*.
RCS_WEB_CORS_ORIGINS=

# ── Next UI ───────────────────────────────────────────────────────────────────
# Baked into client bundles at BUILD time. Leave empty for same-origin (Caddy)
# deployments. Set to the gateway's public origin only for split-host setups.
NEXT_PUBLIC_RCS_API_URL=
# Optional: force the Auth.js base URL behind a proxy. Not needed with Caddy
# (trustHost is enabled and Host/X-Forwarded-Host are trusted).
AUTH_URL=

# ── Caddy ─────────────────────────────────────────────────────────────────────
# Empty/unset → plain HTTP on :80 (local/demo). Set a real hostname (e.g.
# rcs.example.com) to enable automatic HTTPS via Caddy's ACME flow; in that
# mode inbound TCP 80 and 443 (and optionally UDP 443 for HTTP/3) must be
# reachable so Caddy can complete the challenge and serve TLS.
RCS_DOMAIN=

# ── CLI environment (not read by the server) ──────────────────────────────────
# Point the `claude remote-control` bridge at this deployment. In this build the
# CLAUDE_BRIDGE_* overrides are gated on USER_TYPE=ant:
#   USER_TYPE=ant
#   CLAUDE_BRIDGE_BASE_URL=https://rcs.example.com
#   CLAUDE_BRIDGE_OAUTH_TOKEN=rcs_...   # per-user API key from /code/settings
#   CLAUDE_BRIDGE_SESSION_INGRESS_URL=https://rcs.example.com   # optional
