# Example: front RCS with an existing host nginx (ports 80/443 already taken by
# another site). Pairs with docker-compose.override.yml.example, which disables
# the bundled Caddy and publishes app/gateway on 127.0.0.1:3100 / :4100.
#
# Replace rcs.example.com with the hostname that resolves to this server, then
# enable TLS with `certbot --nginx -d rcs.example.com`. If your nginx already
# defines a `$connection_upgrade` map, delete the map block below.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name rcs.example.com;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    client_max_body_size 50m;

    # SSE: disable buffering or event streams are held until complete.
    location /web/       { proxy_pass http://127.0.0.1:4100; proxy_buffering off; proxy_read_timeout 3600s; }
    # WebSocket (/acp/ws, /acp/relay) upgrades via the headers above; this prefix
    # also carries SSE (/acp/channel-groups/:id/events), so disable buffering too.
    location /acp/       { proxy_pass http://127.0.0.1:4100; proxy_buffering off; proxy_read_timeout 3600s; }
    location /v1/        { proxy_pass http://127.0.0.1:4100; }
    location /v2/        { proxy_pass http://127.0.0.1:4100; }
    location /api/oauth/ { proxy_pass http://127.0.0.1:4100; }
    location = /health   { proxy_pass http://127.0.0.1:4100; }

    location / { proxy_pass http://127.0.0.1:3100; } # Next UI
}
