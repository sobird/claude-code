{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": ["react", "jsx-a11y", "import", "promise", "node", "unicorn", "typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "rules": {
    // "curly": "off",
    "eslint-plugin-unicorn/prefer-array-find": "off",
    "eslint/no-await-in-loop": "off",
    // "eslint/no-new": "off",
    "eslint/no-shadow": "off",
    "eslint/no-unmodified-loop-condition": "off",
    "oxc/no-accumulating-spread": "off",
    "oxc/no-async-endpoint-handlers": "off",
    "oxc/no-map-spread": "off",
    "typescript/no-extraneous-class": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/require-post-message-target-origin": "off",

    // Currently zero violations — keep gating new code as errors.
    "unicorn/prefer-node-protocol": "error",

    // Pre-existing backlog: downgraded to warnings so the large legacy backlog
    // no longer fails local hooks/commits. Promote each back to "error" once its
    // remaining violations are cleared.
    "eslint/no-async-promise-executor": "warn",
    "eslint/no-constant-binary-expression": "warn",
    "eslint/no-constant-condition": "warn",
    "eslint/no-control-regex": "warn",
    "eslint/no-new": "warn",
    "eslint/no-unused-vars": "warn",
    "eslint/no-useless-concat": "warn",
    "eslint/no-useless-constructor": "warn",
    "import/no-named-as-default": "warn",
    "import/no-named-as-default-member": "warn",
    "import/no-unassigned-import": "warn",
    "jsx-a11y/no-autofocus": "warn",
    "promise/always-return": "warn",
    "promise/no-multiple-resolved": "warn",
    "promise/no-promise-in-callback": "warn",
    "react/jsx-no-constructed-context-values": "warn",
    "react/no-array-index-key": "warn",
    "react/react-in-jsx-scope": "warn",
    "react/style-prop-object": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "typescript/await-thenable": "warn",
    "typescript/consistent-return": "warn",
    "typescript/no-base-to-string": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-floating-promises": "warn",
    "typescript/no-misused-spread": "warn",
    "typescript/no-redundant-type-constituents": "warn",
    "typescript/no-unnecessary-parameter-property-assignment": "warn",
    "typescript/no-unnecessary-template-expression": "warn",
    "typescript/no-unnecessary-type-conversion": "warn",
    "typescript/no-unnecessary-type-parameters": "warn",
    "typescript/no-unsafe-enum-comparison": "warn",
    "typescript/require-array-sort-compare": "warn",
    "typescript/restrict-template-expressions": "warn",
    "typescript/unbound-method": "warn",
    "unicorn/no-empty-file": "warn",
    "unicorn/no-new-array": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn",
    "unicorn/no-useless-length-check": "warn",
    "unicorn/prefer-add-event-listener": "warn"
  },
  "ignorePatterns": ["dist/", "node_modules/", "vendor/"]
}
