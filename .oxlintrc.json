{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": ["react", "jsx-a11y", "import", "promise", "node", "unicorn", "typescript", "oxc"],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "rules": {
    // "curly": "off",
    "eslint-plugin-unicorn/prefer-array-find": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/no-shadow": "off",
    "eslint/no-unmodified-loop-condition": "off",
    "oxc/no-accumulating-spread": "off",
    "oxc/no-async-endpoint-handlers": "off",
    "oxc/no-map-spread": "off",
    "typescript/no-extraneous-class": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/require-post-message-target-origin": "off",

    // Rules in the correctness/perf/suspicious categories are already gated as
    // errors by `categories` above — listing them again is redundant. Only list
    // rules that need options or fall outside those categories.

    // Restriction category is not enabled; these two are still worth gating.
    "typescript/no-explicit-any": "error",
    "unicorn/prefer-node-protocol": "error",

    // Needs custom options.
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],

    // Off: the rule fights established patterns here and nearly every hit is
    // intentional (2026-11 lint review). Re-evaluate only with a concrete ask.
    "import/no-unassigned-import": "off",
    "jsx-a11y/no-autofocus": "off",
    "promise/always-return": "off",
    "promise/no-multiple-resolved": "off",
    "react/no-array-index-key": "off",
    "react/react-in-jsx-scope": "off",
    "react/style-prop-object": "off",
    "typescript/consistent-return": "off",
    "typescript/no-base-to-string": "off",
    // The codebase intentionally coerces at untyped boundaries (parsed YAML/JSON,
    // network metadata, stdin). The declared type can lie about the runtime type,
    // so removing String()/Boolean()/!! would change behavior.
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/restrict-template-expressions": "off",
    "unicorn/no-new-array": "off",
    "unicorn/prefer-add-event-listener": "off",

    // Noisy in reconstructed code (methods passed as callbacks, intentional
    // partial hook deps); off so the warning list stays actionable.
    "react-hooks/exhaustive-deps": "off",
    "typescript/unbound-method": "off",

    // Flags callback-parameter generics as "used once", but the type parameter
    // is required for contravariant assignability (e.g. LSP onRequest<TParams>).
    // Known false-positive pattern, so off rather than warn.
    "typescript/no-unnecessary-type-parameters": "off"
  },
  "overrides": [
    {
      "files": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        // `await expect(...).rejects.toThrow()` is idiomatic; bun's matcher
        // types are read as void, so the rule only produces false positives.
        "typescript/await-thenable": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/", "node_modules/", "vendor/", "scripts/upgrade/__tests__/fixtures/"]
}
